<Application x:Class="PlantaFieldbus.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="CanvasBrush" Color="#071B22" />
    <SolidColorBrush x:Key="PanelBrush" Color="#102A33" />
    <SolidColorBrush x:Key="AccentBrush" Color="#39D9BA" />
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#E7F6F4" />
    </Style>
  </Application.Resources>
</Application>
